{% layout none %}<!doctype html><html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ 'gift_card.title' | t }} — {{ shop.name | escape }}</title>{% render 'theme-tokens' %}{{ 'theme.css' | asset_url | stylesheet_tag }}<script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script><script src="{{ 'gift-card.js' | asset_url }}" defer></script>{{ content_for_header }}</head><body data-preset="auto"><main class="gift-card prose">
<p>{{ shop.name | escape }}</p>
<h1>{{ 'gift_card.title' | t }}</h1><h2>{{ gift_card.initial_value | money_with_currency }}</h2><p>{% assign formatted_balance = gift_card.balance | money_with_currency %}{{ 'gift_card.balance' | t: balance: formatted_balance }}</p><label for="GiftCardCode">{{ 'gift_card.code' | t }}</label><input id="GiftCardCode" value="{{ gift_card.code | format_code }}" readonly>
<div data-gift-card-qr data-identifier="{{ gift_card.qr_identifier | escape }}" role="img" aria-label="{{ 'gift_card.qr' | t }}" style="width:160px;min-height:160px;margin-block:24px"></div>
{% if gift_card.expired %}<p>{{ 'gift_card.expired' | t }}</p>{% elsif gift_card.expires_on %}{% assign expires = gift_card.expires_on | date: '%B %d, %Y' %}<p>{{ 'gift_card.expires' | t: date: expires }}</p>{% endif %}
<a class="button" href="{{ shop.url }}">{{ 'gift_card.shop' | t }}</a><button class="secondary-button" data-print-gift-card>{{ 'gift_card.print' | t }}</button>{% if gift_card.pass_url %}<a href="{{ gift_card.pass_url }}">{{ 'gift_card.apple' | t }}</a>{% endif %}
</main></body></html>
