<ul id="{{ navigation_id }}" class="menu-list">{% for link in menu.links %}<li>{% if link.links != blank %}<details><summary class="nav-item"><span class="nav-label">{{ link.title | escape }}</span>{% render 'icon', name: 'chevron' %}</summary><ul>{% for child in link.links %}<li>{% if child.links != blank %}<details><summary class="nav-item"><span>{{ child.title | escape }}</span>{% render 'icon', name: 'chevron' %}</summary><ul>{% for grandchild in child.links %}<li><a class="nav-item" href="{{ grandchild.url }}" {% if grandchild.current %}aria-current="page"{% endif %}>{{ grandchild.title | escape }}</a></li>{% endfor %}</ul></details>{% else %}<a class="nav-item" href="{{ child.url }}" {% if child.current %}aria-current="page"{% endif %} {% if child.type == 'collection_link' %}data-catalog-link{% endif %}>{{ child.title | escape }}</a>{% endif %}</li>{% endfor %}</ul></details>{% else %}<a class="nav-item {% if link.current %}active{% endif %}" href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %} {% if link.type == 'collection_link' %}data-catalog-link{% endif %}><span class="nav-label">{{ link.title | escape }}</span></a>{% endif %}</li>{% endfor %}</ul>