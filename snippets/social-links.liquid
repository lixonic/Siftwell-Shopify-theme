{%- capture social_links -%}
  {%- assign social_networks = 'instagram,facebook,pinterest,youtube,tiktok,x' | split: ',' -%}
  {%- for network in social_networks -%}
    {%- liquid
      assign setting_key = 'social_' | append: network | append: '_url'
      assign profile_url = settings[setting_key] | strip
      assign https_prefix = profile_url | slice: 0, 8
      assign http_prefix = profile_url | slice: 0, 7
      assign relative_prefix = profile_url | slice: 0, 2
    -%}
    {%- if https_prefix == 'https://' or http_prefix == 'http://' or relative_prefix == '//' -%}
      {%- assign label_key = 'social.' | append: network -%}
      {%- assign icon_name = 'social-' | append: network -%}
      <li><a href="{{ profile_url | escape }}" aria-label="{{ label_key | t | escape }}">{% render 'icon', name: icon_name %}</a></li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if social_links != blank -%}<nav aria-label="{{ 'social.title' | t | escape }}"><ul class="social-links" role="list">{{ social_links }}</ul></nav>{%- endif -%}
