<form class="filters" method="get">
{% if search.performed %}<input type="hidden" name="q" value="{{ search.terms | escape }}"><input type="hidden" name="options[prefix]" value="last">{% endif %}
<div class="filter-controls">
{% for filter in results.filters %}{% assign filter_index = forloop.index %}<details class="filter-disclosure" {% if filter.active_values.size > 0 %}open{% endif %}><summary>{{ filter.label | escape }}{% render 'icon', name: 'chevron' %}</summary><div class="filter-values">
{% case filter.type %}
{% when 'boolean', 'list' %}{% for value in filter.values %}{% capture input_id %}SearchFilter-{{ section.id }}-{{ filter_index }}-{{ forloop.index }}{% endcapture %}<label class="checkbox-label" for="{{ input_id }}"><input id="{{ input_id }}" type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>{{ value.label | escape }} <small>({{ value.count }})</small></label>{% endfor %}
{% when 'price_range' %}<label for="SearchPriceMin-{{ section.id }}-{{ filter_index }}">{{ 'collection.price_from' | t }}<input id="SearchPriceMin-{{ section.id }}-{{ filter_index }}" type="number" name="{{ filter.min_value.param_name }}" min="0" step="any" inputmode="decimal" {% if filter.min_value.value %}value="{{ filter.min_value.value | divided_by: 100.0 }}"{% endif %}></label><label for="SearchPriceMax-{{ section.id }}-{{ filter_index }}">{{ 'collection.price_to' | t }}<input id="SearchPriceMax-{{ section.id }}-{{ filter_index }}" type="number" name="{{ filter.max_value.param_name }}" min="0" step="any" inputmode="decimal" {% if filter.max_value.value %}value="{{ filter.max_value.value | divided_by: 100.0 }}"{% endif %}></label>
{% endcase %}</div></details>{% endfor %}
<label class="sort-label" for="SearchSort-{{ section.id }}">{{ 'collection.sort' | t }}<select id="SearchSort-{{ section.id }}" name="sort_by">{% assign sort_by = results.sort_by | default: results.default_sort_by %}{% for option in results.sort_options %}<option value="{{ option.value | escape }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name | escape }}</option>{% endfor %}</select></label>
<button class="secondary-button" type="submit">{{ 'general.apply' | t }}</button></div>
<div class="active-filters">{% for filter in results.filters %}{% for value in filter.active_values %}<a href="{{ value.url_to_remove }}">{{ value.label | escape }} {% render 'icon', name: 'close' %}</a>{% endfor %}{% if filter.type == 'price_range' %}{% if filter.min_value.value != blank or filter.max_value.value != blank %}<a href="{{ filter.url_to_remove }}">{{ 'collection.clear' | t: filter: filter.label }} {% render 'icon', name: 'close' %}</a>{% endif %}{% endif %}{% endfor %}</div>
</form>
