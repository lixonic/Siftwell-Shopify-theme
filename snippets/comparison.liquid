<button class="mobile-compare comparison-bar" type="button" data-open-dialog="ProductComparison" hidden>{% render 'icon', name: 'compare' %}{{ 'products.compare' | t }} <span data-comparison-count>0</span></button>
<dialog id="ProductComparison" class="compare-dialog" aria-labelledby="ComparisonTitle"><button class="icon-button dialog-close" type="button" data-close-dialog aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button><div class="popup-scroll" tabindex="0" role="region" aria-labelledby="ComparisonTitle"><div class="dialog-heading"><h2 id="ComparisonTitle">{{ 'compare.title' | t }}</h2></div><div class="comparison-scroll"><table class="compare-table"><caption class="sr-only">{{ 'compare.title' | t }}</caption><thead data-comparison-head></thead><tbody data-comparison-rows></tbody></table></div></div></dialog>
