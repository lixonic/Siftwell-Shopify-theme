{% if localization.available_countries.size > 1 or localization.available_languages.size > 1 %}
{% form 'localization', class: 'localization-form' %}
{% if localization.available_countries.size > 1 %}<label for="Country-{{ section.id }}">{{ 'localization.country' | t }}</label><select name="country_code" id="Country-{{ section.id }}">{% for country in localization.available_countries %}<option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>{{ country.name | escape }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})</option>{% endfor %}</select>{% endif %}
{% if localization.available_languages.size > 1 %}<label for="Language-{{ section.id }}">{{ 'localization.language' | t }}</label><select name="language_code" id="Language-{{ section.id }}">{% for language in localization.available_languages %}<option value="{{ language.iso_code }}" lang="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>{{ language.endonym_name | capitalize }}</option>{% endfor %}</select>{% endif %}
<button class="secondary-button" type="submit">{{ 'localization.update' | t }}</button>
{% endform %}{% endif %}
