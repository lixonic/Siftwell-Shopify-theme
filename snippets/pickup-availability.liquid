{% assign pickup_locations = variant.store_availabilities | where: 'pick_up_enabled', true %}
{% if pickup_locations.size > 0 %}<details class="pickup"><summary>{{ 'products.pickup' | t }}</summary>{% for availability in pickup_locations %}<div>{% if availability.available %}<p>{{ 'products.pickup_ready' | t: location: availability.location.name }}</p><p>{{ 'products.pickup_time' | t: time: availability.pick_up_time }}</p>{% else %}<p>{{ availability.location.name | escape }} — {{ 'products.pickup_unavailable' | t }}</p>{% endif %}{{ availability.location.address | format_address }}</div>{% endfor %}</details>{% endif %}
