{% if settings.enable_compare %}<button class="compare-toggle" type="button" data-compare-product="{{ product.id }}" {% if product.has_only_default_variant and product.available %}data-variant="{{ product.selected_or_first_available_variant.id }}"{% endif %} data-title="{{ product.title | escape }}" data-price="{{ product.price | money_without_trailing_zeros | escape }}" data-vendor="{{ product.vendor | escape }}" data-type="{{ product.type | escape }}" data-url="{{ product.url }}" data-image="{% if product.featured_image %}{{ product.featured_image | image_url: width: 240 }}{% endif %}" aria-pressed="false" aria-label="{{ 'products.compare_named' | t: title: product.title | escape }}"><span class="compare-box">{% render 'icon', name: 'check' %}</span>{{ 'products.compare' | t }}</button>{% endif %}
