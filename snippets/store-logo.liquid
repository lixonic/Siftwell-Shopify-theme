<a class="wordmark" href="{{ routes.root_url }}"{% if settings.logo != blank %} aria-label="{{ settings.brand_name | default: shop.name | escape }}"{% endif %}>{% if settings.logo != blank %}{{ settings.logo | image_url: width: 500 | image_tag: widths: '150, 250, 500', loading: 'eager' }}{% else %}{{ settings.logo_text | default: shop.name | escape }}{% if settings.logo_suffix != blank %}<small>{{ settings.logo_suffix | escape }}</small>{% endif %}{% endif %}</a>
