[
  {
    "name": "theme_info",
    "theme_name": "Siftwell",
    "theme_version": "0.8.0-beta.1",
    "theme_author": "Lixon",
    "theme_documentation_url": "https://github.com/lixonic/Siftwell-Shopify-theme#start-here",
    "theme_support_url": "https://github.com/lixonic/Siftwell-Shopify-theme/issues"
  },
  {
    "name": "t:labels.brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:labels.logo"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:labels.favicon"
      },
      {
        "type": "text",
        "id": "brand_name",
        "label": "t:labels.brand_name"
      },
      {
        "type": "text",
        "id": "logo_text",
        "label": "t:labels.logo_text"
      },
      {
        "type": "text",
        "id": "logo_suffix",
        "label": "t:labels.logo_suffix"
      },
      {
        "type": "select",
        "id": "brand_mark",
        "label": "t:labels.brand_mark",
        "options": [
          {
            "value": "none",
            "label": "None"
          },
          {
            "value": "torque-mark",
            "label": "Workshop"
          },
          {
            "value": "daybreak-mark",
            "label": "Sunrise"
          },
          {
            "value": "hobby-mark",
            "label": "Studio"
          }
        ],
        "default": "none"
      }
    ]
  },
  {
    "name": "t:labels.layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "t:labels.page_width",
        "min": 1100,
        "max": 1800,
        "step": 50,
        "unit": "px",
        "default": 1500
      },
      {
        "type": "range",
        "id": "corner_radius",
        "label": "t:labels.corner_radius",
        "min": 0,
        "max": 20,
        "step": 1,
        "unit": "px",
        "default": 0
      }
    ]
  },
  {
    "name": "t:labels.typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "t:labels.body_font",
