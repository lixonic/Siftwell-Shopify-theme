<nav class="shop-paths page-width{% unless section.settings.compact_mobile == false %} shop-paths--compact-mobile{% endunless %}" aria-label="{{ 'general.shop_by_activity' | t }}">{% for block in section.blocks %}{% assign featured = block.settings.collection %}<a class="path-card path-{{ forloop.index0 }}" href="{{ featured.url | default: routes.collections_url }}" {% if featured %}data-catalog-link{% endif %} {{ block.shopify_attributes }}><span class="path-art">{% render 'icon', name: block.settings.icon %}</span><span class="path-copy"><strong>{{ block.settings.heading | default: featured.title | escape }}</strong></span>{% render 'icon', name: 'arrow-up' %}</a>{% endfor %}</nav>
{% schema %}
{
  "name": "t:labels.collection_links",
  "tag": "section",
  "class": "theme-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "compact_mobile",
      "label": "t:labels.compact_mobile_links",
      "info": "t:labels.compact_mobile_links_help",
      "default": true
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "blocks": [
    {
      "type": "collection",
      "name": "t:labels.collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:labels.collection"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.label"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "t:labels.icon",
          "options": [
            {
              "value": "road-mark",
              "label": "Road"
            },
            {
              "value": "wheel-mark",
              "label": "Wheel"
            },
            {
              "value": "tool-mark",
              "label": "Tool"
            },
            {
              "value": "espresso-mark",
              "label": "Espresso"
            },
            {
              "value": "pour-mark",
              "label": "Pour"
            },
            {
              "value": "cup-mark",
              "label": "Cup"
            },
            {
              "value": "paint-mark",
              "label": "Paint"
            },
            {
              "value": "craft-mark",
              "label": "Craft"
            },
            {
              "value": "stitch-mark",
              "label": "Stitch"
            },
            {
              "value": "compass",
              "label": "Compass"
            }
          ],
          "default": "compass"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:labels.collection_links"
    }
  ]
}
{% endschema %}
