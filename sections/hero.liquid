{% liquid
  assign compact_mobile = true
  if section.settings.compact_mobile == false
    assign compact_mobile = false
  endif
  assign mobile_heading = section.settings.mobile_heading
  if mobile_heading == blank
    assign mobile_heading = 'general.mobile_shop_heading' | t
  else
    assign mobile_heading = mobile_heading | escape
  endif
%}
<section class="intro page-width{% if compact_mobile %} intro--compact-mobile{% endif %}" aria-labelledby="HeroTitle-{{ section.id }}">
<div class="hero-copy">
<h1 id="HeroTitle-{{ section.id }}"><span class="hero-heading--desktop">{% if section.settings.heading_line_1 != blank %}{{ section.settings.heading_line_1 | escape }}<br>{% endif %}{{ section.settings.heading }}</span>{% if compact_mobile %}<span class="hero-heading--mobile">{{ mobile_heading }}</span>{% endif %}</h1>
{% if section.settings.text != blank %}<div class="hero-description rte">{{ section.settings.text }}</div>{% endif %}
<div class="hero-actions hero-actions--desktop">{% render 'hero-action' %}</div>
<div class="hero-search">{% render 'search-form', id: section.id %}</div>
{% if compact_mobile %}<div class="hero-actions hero-actions--mobile">{% render 'hero-action' %}</div>{% endif %}
</div>
<figure class="hero-image">
{% if section.settings.image != blank %}
{% assign hero_max_width = settings.page_width | default: 1500 | divided_by: 2.1 %}
{% capture hero_sizes %}(min-width: 1251px) min(calc((100vw - 320px) / 2.1), {{ hero_max_width }}px), (min-width: 1001px) min(calc((100vw - 280px) / 2.1), {{ hero_max_width }}px), (min-width: 761px) calc((100vw - 280px) * 0.425), (min-width: 381px) calc(100vw - 48px), calc(100vw - 32px){% endcapture %}
{% if compact_mobile %}<picture class="hero-picture"><source media="(max-width: 760px)" srcset="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='1'%20height='1'/%3E">{% endif %}
{{ section.settings.image | image_url: width: 1800 | image_tag: widths: '360, 480, 540, 640, 750, 960, 1100, 1500, 1800', sizes: hero_sizes, fetchpriority: 'high', loading: 'eager' }}{% if compact_mobile %}</picture>{% endif %}{% else %}{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}{% endif %}
{% if section.settings.show_brand_seal and settings.brand_mark != 'none' %}<div class="hero-seal" aria-hidden="true">{% render 'icon', name: settings.brand_mark %}</div>{% endif %}
</figure>
</section>

{% schema %}
{
  "name": "t:labels.shopping_hero",
  "tag": "section",
  "class": "theme-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "compact_mobile",
      "label": "t:labels.compact_mobile_intro",
      "info": "t:labels.compact_mobile_intro_help",
      "default": true
    },
    {
      "type": "text",
      "id": "mobile_heading",
      "label": "t:labels.mobile_heading",
      "info": "t:labels.mobile_heading_help"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "t:labels.heading_line_1",
      "default": "For the"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Long <em>way.</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>Tools and accessories for your car and garage.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "checkbox",
      "id": "show_brand_seal",
      "label": "t:labels.show_brand_seal",
      "default": true
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "presets": [
    {
      "name": "t:labels.shopping_hero"
    }
  ]
}
{% endschema %}
