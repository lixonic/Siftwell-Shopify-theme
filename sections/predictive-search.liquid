{% if predictive_search.performed %}<div data-predictive-content><ul class="predictive-list" role="listbox" aria-label="{{ 'general.search_results' | t }}">
{% for item in predictive_search.resources.products %}<li role="presentation"><a role="option" aria-selected="false" id="PredictiveOption-{{ item.id }}" href="{{ item.url }}">{% if item.featured_image %}{{ item.featured_image | image_url: width: 120 | image_tag: loading: 'lazy' }}{% endif %}<span><strong>{{ item.title | escape }}</strong><small>{{ item.price | money_without_trailing_zeros }}</small></span></a></li>{% else %}<li class="predictive-empty" role="presentation"><p role="status">{{ 'collection.empty' | t }}</p></li>{% endfor %}</ul><a class="predictive-all" href="{{ routes.search_url }}?q={{ predictive_search.terms | url_encode }}">{{ 'search.view_all' | t }}{% render 'icon', name: 'arrow' %}</a></div>{% endif %}

{% schema %}
{
  "name": "t:labels.predictive_search",
  "settings": []
}
{% endschema %}
