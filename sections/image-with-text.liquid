<div class="page-width section-space image-text"><div>{% if section.settings.image %}{{ section.settings.image | image_url: width: 1400 | image_tag: widths: '480, 750, 1100, 1400', sizes: '(min-width: 990px) 45vw, 100vw', loading: 'lazy' }}{% else %}{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}{% endif %}</div><div><h2>{{ section.settings.heading | escape }}</h2><div class="rte">{{ section.settings.text }}</div>{% if section.settings.link != blank %}<a class="button" href="{{ section.settings.link }}">{{ section.settings.label | escape }}</a>{% endif %}</div></div>
{% schema %}
{
  "name": "t:labels.image_with_text",
  "tag": "section",
  "class": "theme-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Made for everyday use"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link"
    },
    {
      "type": "text",
      "id": "label",
      "label": "t:labels.button_label",
      "default": "Learn more"
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "presets": [
    {
      "name": "t:labels.image_with_text"
    }
  ]
}
{% endschema %}
