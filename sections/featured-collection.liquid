<div class="page-width section-space">
 <div class="section-heading"><h2>{{ section.settings.heading | escape }}</h2>{% if section.settings.collection != blank %}<a class="text-button" href="{{ section.settings.collection.url }}">{{ 'general.shop_all' | t }}{% render 'icon', name: 'arrow' %}</a>{% endif %}</div>
 <div class="product-grid">
 {% for item in section.settings.collection.products limit: section.settings.product_limit %}{% render 'product-card', product: item %}{% else %}{% for i in (1..4) %}<article class="product-card"><div class="product-media">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div><h3>{{ 'products.placeholder' | t }}</h3></article>{% endfor %}{% endfor %}
 </div>
</div>
{% schema %}
{
  "name": "t:labels.featured_collection",
  "tag": "section",
  "class": "theme-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "All products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "t:labels.products",
      "min": 4,
      "max": 24,
      "step": 1,
      "default": 8
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "presets": [
    {
      "name": "t:labels.featured_collection"
    }
  ]
}
{% endschema %}
