{% if section.blocks.size > 0 or request.design_mode %}
<div class="page-width section-space customer-reviews">
 {% if section.settings.show_heading %}<h2>{% if section.settings.heading != blank %}{{ section.settings.heading | escape }}{% else %}{{ 'products.reviews.title' | t }}{% endif %}</h2>{% endif %}
 {% for block in section.blocks %}<div class="customer-reviews__app" {{ block.shopify_attributes }}>{% render block %}</div>{% endfor %}
 {% if section.blocks.size == 0 and request.design_mode %}<p class="small-text">{{ 'products.reviews.setup' | t }}</p>{% endif %}
</div>
{% endif %}
{% schema %}
{
  "name": "t:labels.customer_reviews",
  "tag": "section",
  "class": "theme-section",
  "limit": 1,
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "checkbox", "id": "show_heading", "label": "t:labels.show_reviews_heading", "default": true },
    { "type": "text", "id": "heading", "label": "t:labels.heading" }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "t:labels.customer_reviews" }]
}
{% endschema %}
