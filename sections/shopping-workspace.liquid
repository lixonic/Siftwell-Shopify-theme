{% if section.settings.home_decision %}
  {% render 'home-decision', section: section %}
{% else %}
  {% render 'catalog-workspace', section: section %}
{% endif %}
{% schema %}
{
  "name": "t:labels.shopping_catalog",
  "tag": "section",
  "class": "theme-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "home_decision",
      "label": "t:labels.home_decision",
      "info": "t:labels.home_decision_help",
      "default": false
    },
    {
      "type": "text",
      "id": "decision_heading",
      "label": "t:labels.decision_heading"
    },
    {
      "type": "text",
      "id": "decision_text",
      "label": "t:labels.decision_text",
      "default": "Start here. The line under each name is the fact that separates them."
    },
    {
      "type": "collection",
      "id": "decision_collection",
      "label": "t:labels.decision_collection"
    },
    {
      "type": "select",
      "id": "decision_fact",
      "label": "t:labels.decision_fact",
      "options": [
        { "value": "weight", "label": "Weight" },
        { "value": "material", "label": "Material" },
        { "value": "fit", "label": "Fit" },
        { "value": "feature", "label": "Feature" },
        { "value": "best", "label": "Best for" }
      ],
      "default": "feature"
    },
    {
      "type": "select",
      "id": "candidate_count",
      "label": "t:labels.candidate_count",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "5", "label": "5" }
      ],
      "default": "5"
    },
    {
      "type": "text",
      "id": "list_heading",
      "label": "t:labels.list_heading",
      "default": "The rest of the catalog"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "All products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:labels.products_per_page",
      "min": 4,
      "max": 48,
      "step": 1,
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "t:labels.show_filters",
      "default": true
    },
    {
      "type": "text",
      "id": "price_steps",
      "label": "t:labels.price_steps",
      "default": "50,100,200",
      "info": "t:labels.price_steps_help"
    },
    {
      "type": "checkbox",
      "id": "show_advanced_filters",
      "label": "t:labels.show_advanced_filters",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "activity",
      "name": "t:labels.activity",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:labels.collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:labels.shopping_catalog"
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  }
}
{% endschema %}
