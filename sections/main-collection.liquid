{% render 'catalog-workspace', section: section, collection: collection, collection_page: true %}
{% schema %}
{
  "name": "t:labels.collection",
  "tag": "section",
  "class": "theme-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:labels.products_per_page",
      "min": 4,
      "max": 48,
      "step": 1,
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "t:labels.show_filters",
      "default": true
    },
    {
      "type": "text",
      "id": "price_steps",
      "label": "t:labels.price_steps",
      "default": "50,100,200",
      "info": "t:labels.price_steps_help"
    },
    {
      "type": "checkbox",
      "id": "show_advanced_filters",
      "label": "t:labels.show_advanced_filters",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "activity",
      "name": "t:labels.activity",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:labels.collection"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  }
}
{% endschema %}
