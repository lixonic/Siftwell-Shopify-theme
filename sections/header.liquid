<a class="icon-button cart-trigger desktop-cart" href="{{ routes.cart_url }}" data-open-dialog="CartDrawer" aria-label="{{ 'general.bag' | t }}" aria-haspopup="dialog">{% render 'icon', name: 'bag' %}<span class="cart-count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span></a>
<div class="mobile-bar">
<button class="icon-button" type="button" data-open-dialog="NavigationDrawer" aria-label="{{ 'general.menu' | t }}" aria-haspopup="dialog">{% render 'icon', name: 'menu' %}</button>
{% render 'store-logo' %}
<div class="mobile-header-actions" aria-hidden="true"></div>
</div>
<aside class="sidebar" aria-label="{{ 'general.menu' | t }}">
{% render 'store-brand' %}
<a class="sidebar-search" href="{{ routes.search_url }}" data-sidebar-search data-focus-search {% if request.page_type == 'index' %}hidden{% endif %}>{% render 'icon', name: 'search' %}<span>{{ 'general.find_product' | t }}</span><kbd>/</kbd></a>
<nav class="shop-nav" aria-label="{{ 'general.menu' | t }}">{% render 'navigation', menu: section.settings.menu, navigation_id: 'category-nav' %}</nav>

<div class="sidebar-bottom">{% if section.settings.about_page != blank %}<a class="text-link" href="{{ section.settings.about_page.url }}" data-page-popup>{{ 'general.about' | t }}{% render 'icon', name: 'arrow-up' %}</a>{% endif %}</div>
</aside>
<span class="header-account">{% render 'account' %}</span>
<a class="icon-button cart-trigger mobile-cart" href="{{ routes.cart_url }}" data-open-dialog="CartDrawer" aria-label="{{ 'general.bag' | t }}">{% render 'icon', name: 'bag' %}<span class="cart-count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span></a>
<dialog id="NavigationDrawer" class="drawer navigation-drawer" aria-labelledby="NavigationTitle">
<div class="dialog-heading"><h2 id="NavigationTitle">{{ 'general.menu' | t }}</h2><button class="icon-button" type="button" data-close-dialog aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button></div>
<div class="drawer-scroll">{% render 'store-brand' %}<nav class="shop-nav" aria-label="{{ 'general.menu' | t }}">{% render 'navigation', menu: section.settings.menu, navigation_id: 'mobile-category-nav' %}</nav>
<a class="sidebar-search" href="{{ routes.search_url }}" data-sidebar-search {% if request.page_type == 'index' %}hidden{% endif %}>{% render 'icon', name: 'search' %}{{ 'general.search' | t }}</a>
{% if section.settings.about_page != blank %}<a class="text-link" href="{{ section.settings.about_page.url }}" data-page-popup>{{ 'general.about' | t }}</a>{% endif %}
</div></dialog><noscript><nav class="no-js-navigation">{% render 'navigation', menu: section.settings.menu %}</nav></noscript>

{% schema %}
{
  "name": "t:labels.header",
  "tag": "header",
  "class": "header-section",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "page",
      "id": "about_page",
      "label": "t:labels.about_page"
    }
  ]
}
{% endschema %}
