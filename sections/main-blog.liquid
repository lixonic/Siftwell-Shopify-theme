<div class="page-width section-space"><h1>{{ blog.title | escape }}</h1>{% paginate blog.articles by 9 %}<div class="article-grid">{% for article in blog.articles %}<article>{% if article.image %}<a href="{{ article.url }}">{{ article.image | image_url: width: 1100 | image_tag: widths: '480, 750, 1100', sizes: '(min-width: 990px) 30vw, 100vw', loading: 'lazy' }}</a>{% endif %}<h2><a href="{{ article.url }}">{{ article.title | escape }}</a></h2><div class="rte">{{ article.excerpt_or_content | strip_html | truncatewords: 35 }}</div></article>{% endfor %}</div>{% render 'pagination', paginate: paginate %}{% endpaginate %}</div>
{% schema %}
{
  "name": "t:labels.blog",
  "tag": "section",
  "class": "theme-section",
  "settings": [],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  }
}
{% endschema %}
