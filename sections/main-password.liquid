<div class="page-width section-space prose"><h1>{{ shop.name | escape }}</h1><h2>{{ 'password.title' | t }}</h2><div class="rte">{{ shop.password_message }}</div>{% render 'newsletter' %}<details><summary>{{ 'password.login' | t }}</summary>{% form 'storefront_password' %}{% if form.errors %}<div role="alert">{{ form.errors | default_errors }}</div>{% endif %}<label for="StorePassword">{{ 'password.password' | t }}</label><input id="StorePassword" type="password" name="password" required><button class="button" type="submit">{{ 'password.enter' | t }}</button>{% endform %}</details>{{ powered_by_link }}</div>
{% schema %}
{
  "name": "t:labels.password",
  "settings": []
}
{% endschema %}
